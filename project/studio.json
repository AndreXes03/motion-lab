    {
      "id": "bax",
      "title": "Objects in play",
      "subtitle": "Three 3D objects, studio lighting and a cinematic camera.",
      "kind": "3d",
      "controls": [
        {
          "id": "shell",
          "label": "Shell",
          "type": "color",
          "path": "shell",
          "default": "#173bd5",
          "help": "Radio color; leaves other objects unchanged."
        },
        {
          "id": "knob",
          "label": "Knob",
          "type": "color",
          "path": "knob",
          "default": "#f34a13",
          "help": "Center knob color."
        },
        {
          "id": "display",
          "label": "Display",
          "type": "text",
          "path": "display",
          "default": "",
          "help": "Optional LED text. Leave blank to keep the original sequence."
        },
        {
          "id": "energy",
          "label": "Object energy",
