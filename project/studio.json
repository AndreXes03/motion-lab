{
  "version": 1,
  "projects": [
    {
      "id": "bax",
      "title": "Objects in play",
      "subtitle": "Tre oggetti tridimensionali, luce da studio e camera cinematografica.",
      "kind": "3d",
      "controls": [
        {"id":"shell","label":"Scocca","type":"color","path":"shell","default":"#173bd5","help":"Colore della radio; non modifica gli altri oggetti."},
        {"id":"knob","label":"Manopola","type":"color","path":"knob","default":"#f34a13","help":"Colore della manopola centrale."},
        {"id":"display","label":"Display","type":"text","path":"display","default":"","help":"Testo LED opzionale. Vuoto mantiene la sequenza originale."},
        {"id":"energy","label":"Energia oggetti","type":"range","min":0,"max":1.8,"step":0.05,"path":"objectMotion","default":1,"help":"Intensità e velocità degli oggetti; la camera resta invariata."},
        {"id":"contrast","label":"Contrasto luce","type":"range","min":0,"max":1,"step":0.01,"path":"look.lighting","default":0.85,"help":"Bilancia fill, rim e ambiente senza cambiare la composizione."}
      ],
      "moments": [
        {"label":"Radio","time":0.6},
        {"label":"Gyro","time":2.6},
        {"label":"Cover aperta","time":4.7},
        {"label":"Emblema","time":5.6},
        {"label":"Hero","time":8.8}
      ],
      "presets": [
        {"id":"original","label":"Originale","values":{"energy":1,"contrast":0.85},"look":{}},
        {"id":"sculpted","label":"Scolpito","values":{"energy":1.2,"contrast":0.78},"look":{"lighting":{"key":360,"fill":0.035,"rim":4.6,"environment":0.57},"post":{"exposure":1.07,"aoIntensity":0.52,"aberrationPx":3.2}}},
        {"id":"softbox","label":"Softbox","values":{"energy":0.8,"contrast":0.35},"look":{"lighting":{"key":290,"fill":0.12,"rim":3.2,"environment":0.78},"post":{"exposure":1.08,"aoIntensity":0.28,"aberrationPx":2.2,"vignette":0.13}}}
      ]
    },
    {
      "id": "procedural",
      "title": "Motion / By Code",
      "subtitle": "Tipografia, forme e ritmo 2D calcolati frame per frame.",
      "kind": "2d",
      "controls": [
        {"id":"title","label":"Titolo","type":"text","path":"graphics.title","default":"MOTION","help":"Testo principale delle scene 2D."},
        {"id":"accent","label":"Accento","type":"color","path":"graphics.accent","default":"#ff5a24","help":"Colore delle forme e delle transizioni."},
        {"id":"density","label":"Densità","type":"range","min":4,"max":18,"step":1,"path":"graphics.density","default":10,"help":"Numero di elementi ripetuti nella composizione."},
        {"id":"speed","label":"Ritmo","type":"range","min":0.25,"max":2.5,"step":0.05,"path":"graphics.speed","default":1,"help":"Velocità dei gesti; non cambia durata o fps."}
      ],
      "moments": [
        {"label":"Opening","time":1.3},
        {"label":"By Code","time":4.1},
        {"label":"Wordmark","time":7.6},
        {"label":"Finale","time":9.4}
      ],
      "presets": [
        {"id":"original","label":"Originale","values":{"title":"MOTION","accent":"#ff5a24","density":10,"speed":1}},
        {"id":"punch","label":"Punch","values":{"title":"MOTION","accent":"#ff451f","density":15,"speed":1.35}},
        {"id":"calm","label":"Calmo","values":{"title":"MOTION","accent":"#d98d68","density":6,"speed":0.7}}
      ]
    }
  ]
}
